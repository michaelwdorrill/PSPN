    {
      "id": "feature-injury-report-s1-w12",
      "type": "feature",
      "title": "The waiting room is full: Week 12 injury report",
      "dek": "Sixteen new absences, ten cleared recovery counters, and a changing cast for the playoff push. Ninjaskamara, Mr. Clanky and My Way, Son headline the league-wide report.",
      "author": "tessa-wren",
      "teams": [
        "viridian",
        "pewter",
        "celadon",
        "cinnabar",
        "cerulean",
        "saffron",
        "vermilion",
        "fuchsia",
